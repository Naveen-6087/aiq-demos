# ArmorIQ API Key (required) - get from https://platform.armoriq.ai, or run
# `armoriq login` via the SDK's bundled CLI
ARMORIQ_API_KEY=ak_live_your_api_key_here

# Server port
PORT=3003

# ArmorIQ session mode: "sdk" gets a real allow/hold/block decision from the
# backend (holds create an approvable delegation) while THIS process executes
# the tool call locally. Use "sdk", not "proxy" - both registered MCP servers
# are stdio-transport, which ArmorIQ's cloud proxy cannot reach for
# dispatch() (confirmed: it 502s). See src/mcpClient.js.
ARMORIQ_MODE=sdk

# Optional - where the memory MCP server persists its knowledge graph JSON.
# Leave unset to use the server's own default location.
MEMORY_FILE_PATH=

# User email for ArmorIQ session scoping
USER_EMAIL=developer@armoriq.ai

# Names each MCP server is registered under in the ArmorIQ dashboard
# (Platform > MCP Servers). Tool calls are namespaced "<mcp>__<action>", so a
# single plan/session can span both.
FILESYSTEM_MCP_NAME=filesystem
MEMORY_MCP_NAME=memory

# Local file this agent reads and summarizes into the knowledge graph
SOURCE_FILE=./research/source.md
