# ArmorIQ API Key (required) - get from https://platform.armoriq.ai, or run
# `armoriq login` via the SDK's bundled CLI
ARMORIQ_API_KEY=ak_live_your_api_key_here

# Server port
PORT=3001

# ArmorIQ session mode: "sdk" gets a real allow/hold/block decision from the
# backend (holds create an approvable delegation) while THIS process executes
# the tool call locally. Use "sdk", not "proxy" - the registered filesystem
# MCP server is stdio-transport, which ArmorIQ's cloud proxy cannot reach for
# dispatch() (confirmed: it 502s). See src/mcpClient.js.
ARMORIQ_MODE=sdk

# User email for ArmorIQ session scoping
USER_EMAIL=developer@armoriq.ai

# Name the filesystem MCP server is registered under in the ArmorIQ dashboard
# (Platform > MCP Servers)
FILESYSTEM_MCP_NAME=filesystem

# Root directory this agent is allowed to talk about (must be inside the
# directory the filesystem MCP server itself was started with)
NOTES_DIR=./notes

# Optional - get from https://aistudio.google.com. When set, goals are
# planned by a real Gemini call instead of the keyword fallback in
# src/planner.js, so you can ask genuinely open-ended questions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
