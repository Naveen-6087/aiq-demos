# ArmorIQ API Key (required) - get from https://platform.armoriq.ai, or run
# `armoriq login` via the SDK's bundled CLI
ARMORIQ_API_KEY=ak_live_your_api_key_here

# Gemini API key (required) - get from https://aistudio.google.com
# Only the model construction in agent.js depends on this; swap in any other
# @langchain/* chat model and everything below it (tools, ArmorIQLangChain,
# the agent executor) is unchanged.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# User email for ArmorIQ session scoping
USER_EMAIL=developer@armoriq.ai

# Name the weather MCP server is registered under in the ArmorIQ dashboard
# (Platform > MCP Servers) - see README.md for what to register
WEATHER_MCP_NAME=weather
