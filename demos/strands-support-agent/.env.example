# ArmorIQ API Key (required) - get from https://platform.armoriq.ai, or run
# `armoriq login` via the SDK's bundled CLI
ARMORIQ_API_KEY=ak_live_your_api_key_here

# Gemini API key (required) - get from https://aistudio.google.com
# Only the model construction in agent.py depends on this; strands-agents
# ships first-party providers for Bedrock, Anthropic, OpenAI, and others too -
# swap GeminiModel for any of those and everything else (tools, ArmorIQStrands,
# the agent) is unchanged.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# User email for ArmorIQ session scoping
USER_EMAIL=developer@armoriq.ai

# Name the support-desk MCP server is registered under in the ArmorIQ
# dashboard (Platform > MCP Servers) - see README.md for what to register
SUPPORT_DESK_MCP_NAME=support-desk
