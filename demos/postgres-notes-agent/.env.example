# ArmorIQ API Key (required) - get from https://platform.armoriq.ai, or run
# `armoriq login` via the SDK's bundled CLI
ARMORIQ_API_KEY=ak_live_your_api_key_here

# Server port
PORT=3004

# ArmorIQ session mode: "sdk" gets a real allow/hold/block decision from the
# backend (holds create an approvable delegation) while THIS process executes
# the tool call locally. Use "sdk", not "proxy" - the registered postgres MCP
# server is stdio-transport, which ArmorIQ's cloud proxy cannot reach for
# dispatch(). See src/mcpClient.js (and the other cookbook demos' READMEs for
# the confirmed 502 behind this).
ARMORIQ_MODE=sdk

# User email for ArmorIQ session scoping
USER_EMAIL=developer@armoriq.ai

# Name the postgres MCP server is registered under in the ArmorIQ dashboard
# (Platform > MCP Servers)
POSTGRES_MCP_NAME=postgres

# Postgres connection string. `docker compose up -d` in this folder starts a
# local Postgres matching this default - see README.md.
DATABASE_URL=postgresql://armoriq:armoriq_demo_password@localhost:55432/armoriq_notes

# Optional - get from https://aistudio.google.com. When set, goals are
# planned by a real Gemini call instead of the keyword fallback in
# src/planner.js, so you can ask genuinely open-ended questions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
