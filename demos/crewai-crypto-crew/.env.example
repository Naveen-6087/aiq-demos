# ArmorIQ API Key (required) - get from https://platform.armoriq.ai, or run
# `armoriq login` via the SDK's bundled CLI
ARMORIQ_API_KEY=ak_live_your_api_key_here

# Gemini API key (required) - get from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# CoinGecko Demo API key (optional) - get a free one at
# https://www.coingecko.com/en/api/pricing. Keyless works too, just capped
# at 5 calls/min instead of 30.
COINGECKO_API_KEY=

# Comma-separated CoinGecko coin ids for the crew to research
COINS=bitcoin,ethereum,solana
