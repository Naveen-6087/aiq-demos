# ArmorIQ API Key (required) - get from https://platform.armoriq.ai, or run
# `armoriq login` via the SDK's bundled CLI
ARMORIQ_API_KEY=ak_live_your_api_key_here

# Server port
PORT=3005

# ArmorIQ session mode: "sdk" gets a real allow/hold/block decision from the
# backend while THIS process executes the tool call locally. Use "sdk", not
# "proxy" - the coingecko MCP server is stdio-transport, which ArmorIQ's
# cloud proxy cannot reach for dispatch(). See src/mcpClient.js.
ARMORIQ_MODE=sdk

# User email for ArmorIQ session scoping
USER_EMAIL=developer@armoriq.ai

# Name the coingecko MCP server is registered under in the ArmorIQ dashboard
# (Platform > MCP Servers) - see README.md, it's a custom entry
COINGECKO_MCP_NAME=coingecko

# CoinGecko Demo API key (get a free one at
# https://www.coingecko.com/en/api/pricing). Optional - the free/keyless
# tier works too, just capped at 5 calls/min instead of 30.
COINGECKO_API_KEY=

# Required for genuinely open-ended questions ("what's SOL worth in INR").
# Get from https://aistudio.google.com. Without it, the agent falls back to
# a hardcoded Bitcoin-only keyword planner (src/planner.js).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
